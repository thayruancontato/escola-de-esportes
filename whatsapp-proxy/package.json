{
  "name": "backend-escola-de-esportes",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Cloudflare Worker para Escola de Esportes: Asaas, WhatsApp, fila, upload de imagens e automações.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist-dry-run",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv:namespace create UBA_STORAGE",
    "kv:list": "wrangler kv:namespace list"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
